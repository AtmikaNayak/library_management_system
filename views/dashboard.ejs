<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashoard</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>
<body>
    <div class="sidebar">
        <div class="logo-container">
            <img src="/logo.png" alt="Library Management System Logo" class="sidebar-logo">
        </div>
        <a href="/dashboard"><i class="fa-solid fa-chart-column"></i> Dashboard</a>
        <a href="/books"> <i class="fa-solid fa-book"></i> Books</a>
        <a href="/borrowedbooks"><i class="fa-solid fa-hand-holding-hand"></i> Borrowed books</a>
        <a href="/students"><i class="fa-solid fa-user-graduate"></i> Students</a>
        <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </div>
    <div class="main">
        <h1>Welcome <%= librarian.name %></h1>
        <div class="cards">
            <div class="card">
                <i class="fa-solid fa-book-open"></i>
                <h2><%= totalBooks %></h2>
                <p>Total Books</p>
            </div>
            <div class="card">
                <i class="fa-solid fa-book-open-reader"></i>
                <h2><%= totalBorrowed %></h2>
                <p>Total Borrowed</p>
            </div>
            <div class="card">
                <i class="fa-solid fa-users"></i>
                <h2><%= totalVisits %></h2>
                <p>Total Visits</p>
            </div>
            
        </div>
    </div>
</body>
</html>