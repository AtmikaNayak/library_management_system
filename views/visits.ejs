<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library Visits</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
    <div class="sidebar">
        <div class="logo-container">
            <img src="/logo.png" alt="Library Management System Logo" class="sidebar-logo">
        </div>
        <a href="/dashboard"><i class="fa-solid fa-chart-column"></i> Dashboard</a>
        <a href="/books"> <i class="fa-solid fa-book"></i> Books</a>
        <a href="/borrowedbooks"><i class="fa-solid fa-hand-holding-hand"></i> Borrowed books</a>
        <a href="/students"><i class="fa-solid fa-user-graduate"></i> Students</a>
        <a href="/visits"><i class="fa-solid fa-people-roof"></i> Library Visits</a>
        <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </div>
    <div class="borrowed-books">
        <h1>LIBRARY VISITS</h1>
        <div class="table-wrapper">
        <table>
            <tr>
                <th>USN</th>
                <th>Branch</th>
                <th>Entry Time</th>
                <th>Exit Time</th>
                <th>Duration</th>
                <th>Status</th>
            </tr>
            <% b_books.forEach(b_book=> { %>
                <tr>
                    <td>
                        <%= b_book.usn %>
                    </td>
                    <td>
                        <%= b_book.branch %>
                    </td>
                    <td>
                        <%= new Date(b_book.entry_time).toLocaleTimeString('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    }) %>
                    </td>
                    <td>
                        <%= new Date(b_book.exit_time).toLocaleTimeString('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
    }) %>
                    </td>
                    <td>
                        <%= b_book.duration %>
                    </td>
                    <td>
                        <%= b_book.status %>
                    </td>
                </tr>
                <% }) %>
        </table>
        </div>
    </div>
</body>

</html>